[Unit]
Description=Discover Surface Bluetooth after initramfs handoff
After=systemd-udev-trigger.service systemd-udevd.service local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/udevadm trigger --action=add --subsystem-match=bluetooth
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
